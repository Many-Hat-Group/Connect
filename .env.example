# Connect environment. install.sh creates .env from this file, fills in the
# random secrets and keeps it at mode 600. Never commit .env.
# Values marked "Pierce" must be supplied (pass them to install.sh as
# environment variables, or edit .env and re-run install.sh).

# --- Public entry --------------------------------------------------------
PUBLIC_URL=https://connect.mhits.au            # Pierce
PUBLIC_HOST=connect.mhits.au                   # Pierce (host[:port] of PUBLIC_URL)
TRUSTED_PROXY_IP=                              # Pierce: the edge nginx proxy's IP
ROUTER_BIND_IP=                                # Pierce: this LXC's internal NIC IP (8080 is published only here)

# --- TURN (coturn, host network) -----------------------------------------
TURN_HOST=turn.mhits.au                        # Pierce
TURN_LISTEN_IP=                                # Pierce: IP coturn binds to (public IP for option a, internal IP for option b)
TURN_RELAY_IP=                                 # Pierce: usually the same as TURN_LISTEN_IP
TURN_EXTERNAL_IP=                              # Pierce: the public IP (option b: "public/internal")
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_EXTRA_DENIED_RANGES=                      # Pierce: datacenter's own ranges, "a.b.c.d-e.f.g.h,..."

# --- TURN certificate (DNS-01, Cloudflare token scoped to the zone) ------
CERTBOT_EMAIL=                                 # Pierce
CLOUDFLARE_DNS_API_TOKEN=                      # Pierce
CERTBOT_STAGING=                               # set to 1 to test against Let's Encrypt staging

# --- Internal --------------------------------------------------------------
DOCKER_SUBNET=172.31.250.0/24
DOCKER_IP_RANGE=172.31.250.128/25
ROUTER_IP=172.31.250.10
BACKUP_KEEP_DAYS=14
BACKUP_AT=02:30

# --- Secrets (generated by install.sh) -----------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
TURN_SHARED_SECRET=
SETUP_TOKEN=
