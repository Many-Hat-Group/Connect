# coturn configuration template. Rendered at container start by
# coturn/entrypoint.sh from environment variables (see .env.example).
# Do not put secrets in this file.

listening-port=3478
tls-listening-port=5349
listening-ip=${TURN_LISTEN_IP}
relay-ip=${TURN_RELAY_IP}
external-ip=${TURN_EXTERNAL_IP}
min-port=${TURN_MIN_PORT}
max-port=${TURN_MAX_PORT}

realm=${TURN_REALM}
server-name=${TURN_REALM}

# Ephemeral credentials: username = <unix expiry>:<session id>,
# password = base64(HMAC-SHA1(secret, username)). Issued by the app.
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}

# TLS on 5349 (certificate from the certbot service, DNS-01).
cert=${TURN_CERT_FILE}
pkey=${TURN_KEY_FILE}
no-tlsv1
no-tlsv1_1
cipher-list="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305"

fingerprint
no-multicast-peers
no-cli
no-software-attribute
no-rfc5780
no-stun-backward-compatibility
response-origin-only-with-rfc5780

# Quotas
user-quota=${TURN_USER_QUOTA}
total-quota=${TURN_TOTAL_QUOTA}
max-bps=${TURN_MAX_BPS}

# Never relay into private, loopback, link-local, CGNAT, multicast or
# reserved ranges, so TURN cannot be used to reach internal networks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Datacenter's own ranges (comma separated list in TURN_EXTRA_DENIED_RANGES,
# each "start-end"); rendered one per line by entrypoint.sh.
${TURN_EXTRA_DENIED_LINES}

log-file=stdout
simple-log
